---
interface Props { lang: 'de' | 'at' | 'en' }
const de = Astro.props.lang !== 'en';
const cases = de ? [
  { type: 'LÖSUNGSKONZEPT', title: 'Rechnungen schneller prüfen', copy: 'Eingangsbelege aus E-Mail übernehmen, Pflichtfelder validieren und Abweichungen zur Prüfung markieren.', outcome: 'Ziel: weniger Doppelerfassung, klare Ausnahmen.', art: 'invoice' },
  { type: 'LÖSUNGSKONZEPT', title: 'Aufträge an einem Ort steuern', copy: 'Ein internes Auftragsboard bündelt Anfragen, Zuständigkeiten, Fristen und Status – statt verstreuter Tabellen.', outcome: 'Ziel: offene Vorgänge und nächste Schritte sehen.', art: 'orders' },
  { type: 'LÖSUNGSKONZEPT', title: 'Bestände verlässlich abgleichen', copy: 'Lagerdaten zwischen Warenwirtschaft und Shop synchronisieren und definierte Schwellen sichtbar machen.', outcome: 'Ziel: weniger manuelle Abgleiche, frühere Hinweise.', art: 'stock' },
] : [
  { type: 'SOLUTION CONCEPT', title: 'Review invoices with less effort', copy: 'Collect incoming documents, validate required fields and flag exceptions for review.', outcome: 'Goal: less duplicate entry, clearer exceptions.', art: 'invoice' },
  { type: 'SOLUTION CONCEPT', title: 'Manage orders in one place', copy: 'An internal order board brings requests, owners, due dates and status together instead of scattered sheets.', outcome: 'Goal: see open work and its next step.', art: 'orders' },
  { type: 'SOLUTION CONCEPT', title: 'Keep stock data in sync', copy: 'Synchronise inventory between the business system and online shop, with clear threshold alerts.', outcome: 'Goal: fewer manual checks, earlier signals.', art: 'stock' },
];
---
<section class="project-examples" aria-labelledby="examples-title">
  <div class="examples-heading">
    <div><span class="eyebrow"><i></i>{de ? 'TYPISCHE VORHABEN' : 'TYPICAL PROJECTS'}</span><h2 id="examples-title">{de ? 'Konkrete Lösungen für wiederkehrende Aufgaben.' : 'Practical solutions for recurring work.'}</h2></div>
    <p>{de ? 'Rechnungen prüfen, Aufträge steuern, Bestände abgleichen: Nexalane entwickelt die passende Software und bindet sie in bestehende Abläufe ein.' : 'Review invoices, manage orders and reconcile stock. Nexalane builds the right software and fits it into existing workflows.'}</p>
  </div>
  <div class="example-list">
    {cases.map((item) => <article class:list={['example', `example-${item.art}`]}>
      <div class="example-art" role="img" aria-label={`${item.title} – ${de ? 'Arbeitsablauf' : 'workflow'}`}>
        {item.art === 'invoice' && <div class="invoice-art"><div class="mail-strip"><span>PDF</span><b>{de ? 'eingang_rechnung.pdf' : 'incoming_invoice.pdf'}</b><i>↓</i></div><div class="paper-doc"><span>{de ? 'RECHNUNG' : 'INVOICE'}</span><b>{de ? 'Lieferant' : 'Vendor'}</b><small>{de ? 'Rechnungsnummer · Datum' : 'Invoice number · Date'}</small><div class="doc-lines"><i></i><i></i><i></i></div><strong>€ 1.240,00</strong></div><div class="check-list"><span>✓ {de ? 'Lieferant erkannt' : 'Vendor matched'}</span><span>✓ {de ? 'Betrag validiert' : 'Amount validated'}</span><span class="review">! {de ? 'Freigabe erforderlich' : 'Approval required'}</span></div></div>}
        {item.art === 'orders' && <div class="orders-art"><aside><b>N</b><i></i><i></i><i></i></aside><div class="orders-window"><header><b>{de ? 'Aufträge' : 'Orders'}</b><span>＋ {de ? 'Neuer Auftrag' : 'New order'}</span></header><div class="order-filter">{de ? 'Alle Vorgänge' : 'All requests'}　⌄ <small>⌕ {de ? 'Suchen' : 'Search'}</small></div><div class="order-row row-head"><span>ID</span><span>{de ? 'Kunde' : 'Client'}</span><span>{de ? 'Status' : 'Status'}</span></div><div class="order-row"><b>#1048</b><span>{de ? 'Kunde A' : 'Client A'}</span><em>{de ? 'In Arbeit' : 'In progress'}</em></div><div class="order-row"><b>#1047</b><span>{de ? 'Kunde B' : 'Client B'}</span><em class="amber">{de ? 'Wartet' : 'Waiting'}</em></div><div class="order-row"><b>#1046</b><span>{de ? 'Kunde C' : 'Client C'}</span><em>{de ? 'Prüfung' : 'Review'}</em></div></div></div>}
        {item.art === 'stock' && <div class="stock-art"><div class="stock-connector"><div class="stock-system"><b>ERP</b><span>{de ? 'Lagerdaten' : 'Inventory'}</span><small>1.284 {de ? 'Artikel' : 'items'}</small></div><svg viewBox="0 0 90 100" aria-hidden="true"><path d="M0 22 H70 Q88 22 88 40 V60 Q88 78 70 78 H5" fill="none" stroke="#13a89b" stroke-width="2" stroke-dasharray="4 4"/><path d="m10 72 -7 6 7 6" fill="none" stroke="#13a89b" stroke-width="2"/></svg><div class="stock-system shop"><b>SHOP</b><span>{de ? 'Webshop' : 'Online store'}</span><small>{de ? 'synchronisiert' : 'synchronised'}</small></div></div><div class="stock-alert"><span>!</span><div><b>{de ? 'Mindestbestand erreicht' : 'Reorder threshold reached'}</b><small>{de ? 'Modul B · 8 Stück verfügbar' : 'Module B · 8 units available'}</small></div><strong>{de ? 'Prüfen' : 'Review'} ↗</strong></div></div>}
      </div>
      <div class="example-copy"><span class="example-type">{item.type}</span><h3>{item.title}</h3><p>{item.copy}</p><span class="example-outcome">{item.outcome.replace('Ziel: ','').replace('Goal: ','')}</span></div>
    </article>)}
  </div>
</section>
<style>
  .project-examples{padding:94px max(24px,calc((100% - var(--page))/2)) 102px;background:#eaf3f0;color:var(--navy)}
  .examples-heading{max-width:var(--page);margin:0 auto 36px;display:grid;grid-template-columns:1fr .58fr;gap:45px;align-items:end}
  .examples-heading .eyebrow{grid-column:1/-1}.examples-heading h2{font:750 clamp(34px,4.5vw,53px)/1.05 var(--font-display);letter-spacing:-.045em;max-width:660px;margin:13px 0 0}.examples-heading p{font-size:12px;line-height:1.8;color:#405d65;margin:0 0 2px}
  .example-list{max-width:var(--page);margin:auto;border-top:1px solid #bfd3cc}.example{display:grid;grid-template-columns:1fr .84fr;gap:72px;align-items:center;padding:33px 0;border-bottom:1px solid #bfd3cc}.example:nth-child(even) .example-art{order:2}.example-art{min-height:250px;display:grid;place-items:center;overflow:hidden;background:#f8fbfa;position:relative}.example-invoice .example-art{background:#f7e9dd}.example-orders .example-art{background:#e4eef9}.example-stock .example-art{background:#dceee8}
  .example-copy{max-width:430px}.example-type{font:700 9px ui-monospace,monospace;letter-spacing:.13em;color:#08766d}.example-copy h3{font:750 clamp(25px,3vw,35px)/1.12 var(--font-display);letter-spacing:-.04em;margin:12px 0;color:#10283f}.example-copy p{font-size:13px;line-height:1.8;color:#405b63;margin:0 0 18px}.example-outcome{display:inline-block;padding:8px 10px;background:#fff;color:#194c4b;font-size:10px;font-weight:700}
  .invoice-art{width:84%;max-width:450px;display:grid;grid-template-columns:1fr 1.1fr;gap:13px;align-items:center}.mail-strip{grid-column:1/-1;display:flex;align-items:center;gap:9px;background:#fff;padding:10px 12px;box-shadow:0 4px 14px #132e3812;font-size:8px;color:#27444d}.mail-strip span{color:#bd6749;font:700 8px ui-monospace,monospace}.mail-strip b{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.mail-strip i{margin-left:auto;font-style:normal;color:#087f76}.paper-doc{background:white;min-height:165px;padding:17px 15px;box-shadow:0 12px 28px #603d2718;transform:rotate(-2deg);color:#193746}.paper-doc>span{display:block;color:#b65b3d;font:700 8px ui-monospace,monospace;letter-spacing:.16em}.paper-doc>b{display:block;font-size:11px;margin-top:12px}.paper-doc small{display:block;color:#65767b;font-size:8px;margin-top:3px}.doc-lines{display:grid;gap:5px;margin:14px 0}.doc-lines i{height:2px;background:#e3e9e7}.doc-lines i:nth-child(2){width:72%}.doc-lines i:nth-child(3){width:85%}.paper-doc strong{display:block;text-align:right;font:700 12px var(--font-display)}.check-list{display:grid;gap:9px;font-size:8px;color:#2f6558}.check-list .review{color:#9b5e19}
  .orders-art{width:86%;max-width:460px;min-height:180px;background:#fff;display:flex;box-shadow:0 13px 30px #17334c18;color:#29465a}.orders-art>aside{width:38px;background:#173a57;display:flex;align-items:center;flex-direction:column;gap:15px;padding:12px 0;flex:none}.orders-art aside b{color:#fff;font-size:9px}.orders-art aside i{width:13px;height:13px;border:1px solid #80a4b8}.orders-window{flex:1;padding:13px 14px;min-width:0}.orders-window header{display:flex;align-items:center;justify-content:space-between;font-size:11px}.orders-window header span{padding:5px 7px;background:#176e80;color:#fff;font-size:7px}.order-filter{padding:9px 0;color:#526a70;font-size:8px}.order-filter small{float:right;color:#536a70}.order-row{display:grid;grid-template-columns:.6fr 1fr .9fr;gap:4px;padding:9px 3px;border-top:1px solid #e5ecef;font-size:7px;align-items:center}.row-head{color:#566c70}.order-row b{font-family:ui-monospace,monospace}.order-row em{justify-self:start;font-style:normal;padding:3px 5px;background:#dff3ea;color:#24674f}.order-row em.amber{background:#fff0d9;color:#855716}
  .stock-art{width:82%;max-width:430px;display:grid;gap:14px}.stock-connector{display:flex;align-items:center;justify-content:space-between}.stock-system{display:grid;gap:6px;background:#fff;padding:14px 15px;min-width:112px;box-shadow:0 7px 20px #19384812}.stock-system b{font:700 9px ui-monospace,monospace;color:#087f76}.stock-system span{font-weight:700;font-size:10px;color:#193746}.stock-system small{font-size:8px;color:#566d72}.stock-system.shop{background:#143b50}.stock-system.shop span{color:white}.stock-system.shop small{color:#b6d9d3}.stock-connector svg{width:20%;height:74px}.stock-alert{display:flex;align-items:center;gap:10px;background:#fff;padding:12px}.stock-alert>span{display:grid;place-items:center;width:25px;height:25px;background:#fbe8cf;color:#9a5a12;font-weight:700}.stock-alert div{display:grid;gap:3px}.stock-alert b{font-size:9px;color:#29465a}.stock-alert small{font-size:8px;color:#536a70}.stock-alert strong{margin-left:auto;color:#08766d;font-size:8px}
  @media(max-width:760px){.project-examples{padding:65px 20px}.examples-heading{grid-template-columns:1fr;gap:13px}.examples-heading p{max-width:520px}.example{grid-template-columns:1fr;gap:22px;padding:25px 0}.example:nth-child(even) .example-art{order:initial}.example-art{min-height:220px}.example-copy{max-width:600px}}
  @media(max-width:450px){.example-art{min-height:195px}.invoice-art{width:90%;gap:8px}.paper-doc{min-height:150px;padding:13px 10px}.stock-system{min-width:95px;padding:11px}.stock-alert{gap:7px}.stock-alert b{font-size:8px}.stock-alert small{font-size:7px}}
</style>
