---
interface Props { lang: 'de' | 'at' | 'en' }
const { lang } = Astro.props;
const de = lang !== 'en';
---
<section class="savings" aria-labelledby="savings-title" data-lang={lang}>
  <div class="savings-intro">
    <span class="eyebrow light"><i></i>{de ? 'POTENZIALRECHNER' : 'POTENTIAL CALCULATOR'}</span>
    <h2 id="savings-title">{de ? 'Wie viel Zeit bindet Ihr Ablauf?' : 'How much time does this workflow take?'}</h2>
    <p>{de ? 'Berechnen Sie den jährlichen Kapazitätswert wiederkehrender manueller Arbeit.' : 'Estimate the annual capacity value tied up in recurring manual work.'}</p>
  </div>
  <div class="calculator" data-calculator>
    <div class="calculator-inputs">
      <label>{de ? 'Manuelle Arbeitszeit pro Woche' : 'Manual hours per week'}<span><input data-hours type="number" min="0" max="168" step="0.5" value="6" /> <small>{de ? 'Stunden' : 'hours'}</small></span></label>
      <label>{de ? 'Interner Stundensatz' : 'Internal hourly cost'}<span><small>€</small> <input data-rate type="number" min="0" max="10000" step="1" value="45" /></span></label>
      <label>{de ? 'Potenziell automatisierbarer Anteil' : 'Potentially automatable share'}<span><input data-share type="number" min="0" max="100" step="5" value="50" /> <small>%</small></span></label>
      <p class="calc-formula">{de ? 'Stunden × Stundensatz × Anteil × 52 Wochen' : 'Hours × hourly cost × share × 52 weeks'}</p>
    </div>
    <div class="calculator-results" aria-live="polite">
      <span class="result-label">{de ? 'Jährlicher Kapazitätswert' : 'Annual capacity value'}</span>
      <output data-annual>€ 7.020</output>
      <p data-hours-result>{de ? '3 Stunden pro Woche' : '3 hours per week'}</p>
      <div class="result-divider"></div>
      <span class="result-label">{de ? 'Freie Zeit pro Jahr' : 'Time freed per year'}</span>
      <strong data-hours-annual>156 h</strong>
    </div>
  </div>
</section>
<script>
  const calculator = document.querySelector<HTMLElement>('[data-calculator]');
  if (calculator) {
    const lang = calculator.closest<HTMLElement>('.savings')?.dataset.lang ?? 'de';
    const numberFormat = new Intl.NumberFormat(lang === 'at' ? 'de-AT' : lang === 'de' ? 'de-DE' : 'en-IE', { maximumFractionDigits: 0 });
    const get = (selector: string) => calculator.querySelector<HTMLInputElement>(selector);
    const hours = get('[data-hours]');
    const rate = get('[data-rate]');
    const share = get('[data-share]');
    const annual = calculator.querySelector<HTMLOutputElement>('[data-annual]');
    const hoursResult = calculator.querySelector<HTMLElement>('[data-hours-result]');
    const hoursAnnual = calculator.querySelector<HTMLElement>('[data-hours-annual]');
    const update = () => {
      const weeklyHours = Math.max(0, Number(hours?.value) || 0);
      const hourlyCost = Math.max(0, Number(rate?.value) || 0);
      const automatable = Math.min(100, Math.max(0, Number(share?.value) || 0)) / 100;
      const annualPotential = weeklyHours * hourlyCost * automatable * 52;
      const hoursFreed = weeklyHours * automatable;
      if (annual) annual.textContent = `€ ${numberFormat.format(annualPotential)}`;
      if (hoursResult) hoursResult.textContent = lang !== 'en'
        ? `${new Intl.NumberFormat('de-AT', { maximumFractionDigits: 1 }).format(hoursFreed)} Stunden pro Woche`
        : `${new Intl.NumberFormat('en-IE', { maximumFractionDigits: 1 }).format(hoursFreed)} hours per week`;
      if (hoursAnnual) hoursAnnual.textContent = `${numberFormat.format(hoursFreed * 52)} h`;
    };
    calculator.querySelectorAll('input').forEach((input) => input.addEventListener('input', update));
    update();
  }
</script>
<style>
  .savings{display:grid;grid-template-columns:.8fr 1.2fr;gap:70px;align-items:start;padding:88px max(24px,calc((100% - var(--page))/2));background:#14384b;color:#fff}
  .savings-intro h2{font:750 clamp(35px,4.5vw,51px)/1.04 var(--font-display);letter-spacing:-.045em;max-width:470px;margin:17px 0}.savings-intro>p{font-size:13px;line-height:1.8;color:#d1e2df;max-width:430px}.savings .eyebrow.light{color:#c5ded8}
  .calculator{display:grid;grid-template-columns:1fr .82fr;background:#f8faf9;color:#183347;box-shadow:0 17px 45px #081b2933}.calculator-inputs{padding:25px}.calculator label{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 0;border-bottom:1px solid #dfe8e4;font-size:11px;font-weight:600;color:#294752}.calculator label>span{display:flex;align-items:center;gap:5px;padding:6px 8px;background:white;border:1px solid #cfddd8;white-space:nowrap}.calculator input{width:72px;border:0;outline:0;background:transparent;color:#14384b;text-align:right;font:700 14px var(--font-display);font-variant-numeric:tabular-nums}.calculator label:focus-within>span{outline:2px solid #087f76;outline-offset:1px}.calculator label small{font-size:10px;color:#536b70}.calc-formula{font-size:10px;line-height:1.65;color:#526a70;margin:18px 0 0}
  .calculator-results{display:flex;flex-direction:column;align-items:flex-start;padding:28px 23px;background:#e2f0eb}.result-label{font-size:10px;line-height:1.5;color:#285953}.calculator-results output{font:750 clamp(27px,3.2vw,38px)/1.1 var(--font-display);letter-spacing:-.04em;color:#075d59;margin-top:9px;font-variant-numeric:tabular-nums}.calculator-results p{font-size:11px;color:#365c5a;margin:5px 0 18px}.result-divider{height:1px;width:100%;background:#bdd6cc;margin:0 0 16px}.calculator-results>strong{font:700 20px var(--font-display);color:#14384b;margin:8px 0}.calculator-results>small{font-size:9px;line-height:1.65;color:#405e5d}
  @media(max-width:900px){.savings{grid-template-columns:1fr;gap:32px;padding:65px 24px}.savings-intro>p{max-width:620px}}
  @media(max-width:570px){.savings{padding:56px 20px}.calculator{grid-template-columns:1fr}.calculator-inputs{padding:22px 18px 17px}.calculator-results{padding:22px 18px}.calculator-results output{font-size:34px}}
</style>
