---
import type { Language } from '../content/pages';
interface Props { lang: Language; recipient: string }
const { lang, recipient } = Astro.props;
const de = lang === 'de';
---
<form class="contact-form" lang={lang} action={`https://formsubmit.co/ajax/${recipient}`} method="POST">
  <span class="form-index">AV / CONTACT</span>
  <h2>{de ? 'Projektanfrage senden.' : 'Send a project enquiry.'}</h2>
  <p class="form-intro">{de ? 'Ein paar Stichworte reichen für den Anfang.' : 'A few notes are enough to get started.'}</p>
  <input type="hidden" name="_subject" value={de ? 'Neue AVERNODE Projektanfrage' : 'New AVERNODE project enquiry'} />
  <input type="hidden" name="_template" value="table" />
  <label>{de ? 'Name' : 'Name'}<input name="name" type="text" autocomplete="name" required maxlength="120" /></label>
  <label>{de ? 'E-Mail-Adresse' : 'Email address'}<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
  <label>{de ? 'Unternehmen (optional)' : 'Company (optional)'}<input name="company" type="text" autocomplete="organization" maxlength="160" /></label>
  <label>{de ? 'Worum geht es?' : 'How can we help?'}<textarea name="message" rows="5" required maxlength="5000"></textarea></label>
  <div class="trap" aria-hidden="true"><label>Website<input name="_honey" tabindex="-1" autocomplete="off" /></label></div>
  <p class="form-privacy">{de ? `Ihre Nachricht wird über FormSubmit an ${recipient} übermittelt.` : `Your message will be sent via FormSubmit to ${recipient}.`}</p>
  <div class="form-submit-row"><button type="submit">{de ? 'Anfrage senden' : 'Send enquiry'} <span aria-hidden="true">↗</span></button><p class="form-status" role="status" aria-live="polite"></p></div>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('.contact-form').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const status = form.querySelector<HTMLElement>('.form-status');
      const data = Object.fromEntries(new FormData(form).entries());
      if (data._honey) return;
      if (!button || !status) return;
      const original = button.innerHTML;
      button.disabled = true;
      button.innerHTML = `${form.lang === 'de' ? 'Wird gesendet' : 'Sending'} <span aria-hidden="true">…</span>`;
      status.textContent = '';
      status.classList.remove('success', 'error');
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const result = await response.json();
        if (!response.ok || result.success === false || result.success === 'false') throw new Error('submission_failed');
        form.reset();
        status.textContent = form.lang === 'de' ? 'Danke. Ihre Nachricht wurde gesendet.' : 'Thank you. Your message has been sent.';
        status.classList.add('success');
      } catch {
        status.textContent = form.lang === 'de' ? 'Senden nicht möglich. Bitte versuchen Sie es erneut oder schreiben Sie direkt per E-Mail.' : 'Could not send. Please try again or email us directly.';
        status.classList.add('error');
      } finally {
        button.disabled = false;
        button.innerHTML = original;
      }
    });
  });
</script>
<style>
  .contact-form{background:#e4f1ec;border:1px solid #c5dbd2;padding:30px 32px;color:var(--navy)}
  .form-index{font:8px ui-monospace,monospace;letter-spacing:.13em;color:#566d72}.contact-form h2{font:700 26px/1.2 var(--font-display);letter-spacing:-.03em;margin:16px 0 7px}.form-intro{margin:0 0 19px;font-size:11px;color:#405b63;line-height:1.7}
  .contact-form>label{display:block;margin:13px 0;color:#193746;font-size:11px;font-weight:700}.contact-form input:not([type=hidden]),.contact-form textarea{display:block;width:100%;margin-top:6px;border:1px solid #b6ccc3;border-radius:0;background:#fff;color:#10283f;font:400 13px/1.5 var(--font-body);padding:11px 12px}.contact-form textarea{resize:vertical;min-height:120px}.contact-form input:focus,.contact-form textarea:focus{outline:2px solid #087f76;outline-offset:1px}
  .trap{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.form-privacy{margin:17px 0 12px;font-size:10px;color:#405b63;line-height:1.6}.form-submit-row{display:flex;align-items:center;gap:16px;flex-wrap:wrap}.form-submit-row button{min-height:48px;padding:0 17px;border:0;background:#087f76;color:white;font:700 12px var(--font-body);cursor:pointer}.form-submit-row button:hover{background:#075e59}.form-submit-row button:disabled{opacity:.65;cursor:wait}.form-submit-row button span{margin-left:14px}.form-status{font-size:11px;line-height:1.5;margin:0;max-width:290px}.form-status.success{color:#155d43}.form-status.error{color:#8b3026}
  @media(max-width:520px){.contact-form{padding:24px 20px}.form-submit-row{align-items:flex-start;flex-direction:column;gap:10px}}
</style>
