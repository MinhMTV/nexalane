---
interface Props { inverse?: boolean; compact?: boolean; lang?: 'de' | 'en' }
import { business } from '../config/business';
const { inverse = false, compact = false, lang = 'de' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const homeHref = `${base}${lang}/`;
---
<a class:list={['brand', { inverse, compact }]} href={homeHref} aria-label={`${business.brandName} – ${lang === 'de' ? 'Startseite' : 'Home'}`}>
  <svg class="brand-mark" viewBox="0 0 40 40" aria-hidden="true">
    <path d="M7 29V11l13 18V11l13 18V11" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="square" stroke-linejoin="miter" />
    <circle cx="33" cy="29" r="2.1" fill="currentColor" />
  </svg>
  {!compact && <span class="brand-word">{business.brandName}</span>}
</a>
<style>
  .brand{display:inline-flex;align-items:center;gap:.7rem;color:var(--navy);text-decoration:none;font-weight:800;letter-spacing:.11em;font-size:1.04rem}
  .brand-mark{width:35px;height:35px;color:var(--teal)}.brand.inverse{color:#fff}.brand.inverse .brand-mark{color:#68c4b9}
  .brand.compact .brand-mark{width:31px;height:31px}
</style>
