---
import type { Language } from '../content/pages';
import { pagePath } from '../lib/paths';
interface Props { lang: Language }
const { lang } = Astro.props;
const de = lang === 'de';
const projects = de ? [
  { id: '01', kind: 'RECHNUNGEN · BUCHHALTUNG', title: 'Rechnungsdaten übernehmen statt abtippen.', friction: 'Jede Eingangsrechnung wird geöffnet und Lieferant, Datum, Betrag und Rechnungsnummer werden von Hand eingetragen.', solution: 'Das System liest die wichtigsten Felder aus, prüft Pflichtangaben und bereitet den Eintrag vor. Unklare Werte landen zur Kontrolle bei einer Person.', handoff: 'Nach Freigabe gehen die geprüften Daten an Buchhaltung oder ERP.', estimate: '60 Rechnungen × 4 Minuten weniger Erfassung = rund 4 Stunden pro Monat.', visual: 'paper' },
  { id: '02', kind: 'ANFRAGEN · ANGEBOTE', title: 'Aus einer Anfrage wird ein Angebotsentwurf.', friction: 'Angaben aus E-Mails werden in Vorlagen kopiert. Fehlende Mengen oder Termine müssen einzeln nachgefragt werden.', solution: 'Die Anfrage wird nach Menge, Termin und Positionen sortiert. Fehlende Angaben werden gesammelt; ein Entwurf entsteht aus bestehenden Preisregeln.', handoff: 'Eine Person prüft Preis und Inhalt, bevor das Angebot versendet wird.', estimate: '25 Anfragen × 8 Minuten weniger Kopieren = rund 3 Stunden 20 Minuten pro Monat.', visual: 'quote' },
  { id: '03', kind: 'QUITTUNGEN · AUSLAGEN', title: 'Quittungen schneller zuordnen und verbuchen.', friction: 'Papierbelege und Handyfotos müssen später wiedergefunden, eingetragen und mit Buchungen abgeglichen werden.', solution: 'Das System liest Datum und Betrag aus, schlägt eine passende Buchung vor und markiert Fälle, die nicht eindeutig zusammenpassen.', handoff: 'Geprüfte Belege und Zuordnungen gehen gesammelt an die Buchhaltung.', estimate: '80 Belege × 3 Minuten weniger Suchen und Erfassen = rund 4 Stunden pro Monat.', visual: 'ledger' },
] : [
  { id: '01', kind: 'INVOICES · BOOKKEEPING', title: 'Capture invoice details instead of retyping them.', friction: 'Supplier, date, amount and invoice number are entered by hand for every incoming invoice.', solution: 'The system reads key fields, checks required details and prepares the entry. Unclear values go to a person for review.', handoff: 'Once approved, checked data goes to accounting or ERP.', estimate: '60 invoices × 4 minutes less entry = around 4 hours per month.', visual: 'paper' },
  { id: '02', kind: 'ENQUIRIES · QUOTES', title: 'Turn an enquiry into a quote draft.', friction: 'Details from emails are copied into templates. Missing quantities or dates have to be chased separately.', solution: 'Sort the enquiry by quantity, date and items. Collect missing details and prepare a draft using existing pricing rules.', handoff: 'A person reviews the price and content before sending.', estimate: '25 enquiries × 8 minutes less copying = around 3 hours 20 minutes per month.', visual: 'quote' },
  { id: '03', kind: 'RECEIPTS · EXPENSES', title: 'Match receipts and record expenses faster.', friction: 'Paper receipts and phone photos must be found, entered and matched to transactions later.', solution: 'The system reads the date and amount, suggests a matching transaction and flags cases that need review.', handoff: 'Checked receipts and matches go to accounting together.', estimate: '80 receipts × 3 minutes less searching and entry = around 4 hours per month.', visual: 'ledger' },
];
---
<section class="practical-projects" aria-label={de ? 'Lösungskonzepte für wiederkehrende Arbeit' : 'Solution concepts for recurring work'}>
  <div class="projects-intro"><h2>{de ? 'Drei Abläufe, die im Alltag Zeit kosten.' : 'Three workflows that take time every day.'}</h2><span>{de ? 'Jedes Beispiel zeigt den Handgriff, den die Software übernimmt, was weiterhin geprüft wird und wie eine mögliche Ersparnis zustande kommt.' : 'Each example shows the task software can take over, what still needs review and how potential savings are calculated.'}</span></div>
  <div class="project-list">
    {projects.map(project => <article class:list={['project-story', `project-${project.visual}`]}>
      <div class="project-visual" aria-hidden="true">
        {project.visual === 'paper' && <div class="paper-path"><div class="paper-sheet"><span>{de ? 'EINGANGSRECHNUNG' : 'SUPPLIER INVOICE'}</span><i></i><i></i><i></i><b>{de ? 'Lieferant · Betrag' : 'Supplier · amount'}</b></div><div class="paper-steps"><span>{de ? 'Beleg' : 'Document'}</span><b>→</b><span>{de ? 'Prüfung' : 'Review'}</span><b>→</b><span>{de ? 'Freigabe' : 'Approval'}</span></div></div>}
        {project.visual === 'quote' && <div class="quote-path"><div class="quote-note"><span>✉</span><p>{de ? 'Anfrage mit Menge, Liefertermin und offenen Angaben.' : 'An enquiry with quantity, delivery date and missing details.'}</p></div><div class="quote-arrow">↓</div><div class="quote-output"><span>{de ? 'ANGEBOTSENTWURF' : 'QUOTE DRAFT'}</span><strong>{de ? 'Positionen vorbereitet' : 'Line items prepared'}</strong><small>{de ? 'Menge · Preisregel · Liefertermin' : 'Quantity · pricing rule · delivery date'}</small></div></div>}
        {project.visual === 'ledger' && <div class="ledger-path"><div class="ledger-receipt"><span>{de ? 'BELEG' : 'RECEIPT'}</span><strong>{de ? 'Datum' : 'Date'}</strong><small>{de ? 'Betrag · Händler' : 'Amount · merchant'}</small></div><div class="ledger-match"><span>{de ? 'ZUORDNUNG' : 'MATCH'}</span><b>↔</b><small>{de ? 'Kontoauszug' : 'Bank statement'}</small></div><div class="ledger-result"><b>✓</b><span>{de ? 'Abgeglichen' : 'Matched'}</span></div></div>}
      </div>
      <div class="project-copy"><span class="project-kind">{project.kind}</span><h3>{project.title}</h3><dl><div><dt>{de ? 'Der Aufwand' : 'The effort'}</dt><dd>{project.friction}</dd></div><div><dt>{de ? 'Was entfällt' : 'What changes'}</dt><dd>{project.solution}</dd></div><div><dt>{de ? 'Im Alltag' : 'In practice'}</dt><dd>{project.handoff}</dd></div></dl><div class="project-estimate"><strong>{de ? 'Mögliches Zeitpotenzial' : 'Potential time saved'}</strong><span>{project.estimate}</span></div><a href={pagePath(lang,'contact')}>{de ? 'Diesen Ablauf besprechen' : 'Discuss this workflow'} <span>↗</span></a></div>
    </article>)}
  </div>
</section>
<style>
  .practical-projects{padding:28px 24px 86px;background:#f7f8f4}.projects-intro,.project-list{max-width:var(--page);margin:auto}.projects-intro{padding:38px 0 34px;display:grid;grid-template-columns:.95fr 1fr;column-gap:60px;align-items:end}.projects-intro h2{font:750 clamp(32px,4vw,49px)/1.06 var(--font-display);color:#10283f;letter-spacing:-.045em;margin:0;max-width:570px}.projects-intro>span{font-size:13px;line-height:1.8;color:#405b63;max-width:470px}
  .project-story{display:grid;grid-template-columns:.95fr 1fr;gap:clamp(35px,7vw,92px);align-items:center;padding:38px 0;border-top:1px solid #d4dfda}.project-story:nth-child(even) .project-visual{order:2}.project-visual{min-height:300px;display:grid;place-items:center;overflow:hidden}.project-paper .project-visual{background:#f2e9de}.project-quote .project-visual{background:#dcece8}.project-ledger .project-visual{background:#e8e9f2}.project-kind{font:700 9px ui-monospace,monospace;letter-spacing:.13em;color:#08766d}.project-copy h3{font:750 clamp(25px,3vw,36px)/1.1 var(--font-display);letter-spacing:-.04em;color:#10283f;margin:11px 0 19px}.project-copy dl{margin:0}.project-copy dl>div{display:grid;grid-template-columns:100px 1fr;gap:14px;padding:11px 0;border-top:1px solid #dce4e0}.project-copy dt{font-size:10px;font-weight:700;color:#183b4c}.project-copy dd{margin:0;font-size:11px;line-height:1.7;color:#405b63}.project-estimate{margin-top:12px;padding:14px 15px;background:#e5f0ec;color:#183b4c;display:grid;gap:5px}.project-estimate strong{font-size:11px}.project-estimate span{font-size:11px;line-height:1.6;color:#324f56}.project-copy>a{display:inline-flex;align-items:center;gap:14px;margin-top:18px;color:#075f59;font-size:11px;font-weight:700;text-decoration-thickness:1px;text-underline-offset:4px}
  .paper-path{width:80%;max-width:430px;display:flex;align-items:center;gap:20px}.paper-sheet{width:155px;min-height:192px;background:#fff;padding:18px 15px;box-shadow:0 12px 25px #3b2a1e18;transform:rotate(-3deg);display:flex;flex-direction:column;gap:12px;color:#183b4c}.paper-sheet span,.quote-output>span,.ledger-match>span{font:700 8px ui-monospace,monospace;color:#a15a35;letter-spacing:.11em}.paper-sheet i{height:3px;background:#e4e8e5}.paper-sheet i:nth-of-type(2){width:65%}.paper-sheet i:nth-of-type(3){width:82%}.paper-sheet b{margin-top:auto;text-align:right;font:700 13px var(--font-display)}.paper-steps{display:grid;gap:8px;color:#075f59;font-size:9px;font-weight:700}.paper-steps b{text-align:center;color:#7b9690}
  .quote-path{width:76%;max-width:420px;display:grid;justify-items:center}.quote-note{width:100%;padding:18px;background:#fff;display:flex;align-items:flex-start;gap:13px;box-shadow:0 10px 24px #183b4c13;color:#274c55}.quote-note>span{font-size:19px;color:#087f76}.quote-note p{font:italic 13px/1.6 var(--font-display);margin:0}.quote-arrow{color:#087f76;font-size:19px;padding:5px}.quote-output{width:85%;padding:17px 19px;background:#143b50;color:#fff;display:grid;gap:8px}.quote-output>span{color:#9ad4c9}.quote-output strong{font-size:12px}.quote-output small{font-size:9px;color:#c3d5d7}
  .ledger-path{display:flex;align-items:center;gap:14px;width:86%;max-width:440px}.ledger-receipt{width:125px;height:175px;background:#fff;padding:18px 13px;box-shadow:0 10px 20px #272a4610;display:flex;flex-direction:column;gap:15px;clip-path:polygon(0 0,100% 0,100% 94%,95% 100%,90% 94%,85% 100%,80% 94%,75% 100%,70% 94%,65% 100%,60% 94%,55% 100%,50% 94%,45% 100%,40% 94%,35% 100%,30% 94%,25% 100%,20% 94%,15% 100%,10% 94%,5% 100%,0 94%);color:#273754}.ledger-receipt>span{font:700 8px ui-monospace,monospace;letter-spacing:.12em;color:#656985}.ledger-receipt strong{font:700 19px var(--font-display)}.ledger-receipt small{font:8px ui-monospace,monospace;color:#727891}.ledger-match{display:grid;justify-items:center;gap:8px;color:#273754}.ledger-match>b{font-size:25px;color:#7966ad}.ledger-match small{font-size:8px;color:#555d73}.ledger-result{display:grid;justify-items:center;gap:6px;padding:12px;background:#fff;color:#335d52;font-size:9px}.ledger-result b{font-size:23px}
  @media(max-width:760px){.projects-intro{grid-template-columns:1fr;gap:15px;padding-top:24px}.project-story{grid-template-columns:1fr;gap:22px;padding:27px 0}.project-story:nth-child(even) .project-visual{order:0}.project-visual{min-height:250px}}
  @media(max-width:480px){.practical-projects{padding:15px 20px 65px}.project-visual{min-height:220px}.paper-path{gap:12px}.paper-sheet{width:135px}.paper-steps{font-size:8px}.project-copy dl>div{grid-template-columns:82px 1fr;gap:10px}.ledger-path{gap:9px}}
</style>
