 @media(max-width:390px){.visual-top{gap:7px;padding:0 9px;font-size:7px}.hero-rail{width:32px}.hero-board-head>span{padding:7px;font-size:7px}.hero-last>span:nth-of-type(2){display:none}.custom-app header span{max-width:110px;white-space:nowrap;overflow:hidden}.maintenance-bottom{grid-template-columns:.65fr 1.35fr}.code-rail{gap:5px}.automation-canvas{grid-template-columns:.7fr 15px 1.3fr;padding:10px}.transform-arrow{font-size:18px}}
