 .automation-canvas{display:grid;grid-template-columns:.75fr 30px 1.25fr;align-items:center;padding:22px;background:#f8eee4}.lane-title{display:block;color:#657579;font:700 8px ui-monospace,monospace;letter-spacing:.11em;margin-bottom:14px}.manual-stack{align-self:center}.loose-item{display:flex;align-items:center;gap:9px;background:#fff;color:#a75d3a;padding:11px 10px;margin:9px 0;box-shadow:0 5px 14px #61341b0c;font-size:9px}.loose-item span{color:#324d56}.manual-stack>small{display:block;font-size:8px;color:#5e6e70;margin-top:15px}.transform-arrow{font-size:25px;color:#c67a47;text-align:center}.auto-lane{background:#fff;padding:17px 16px 13px;border:1px solid #d9e2df;box-shadow:0 8px 24px #1e3b4010}.auto-step{display:grid;grid-template-columns:24px 1fr;gap:2px 8px;align-items:center}.auto-step i{grid-row:span 2;width:23px;height:23px;background:#dff2ec;color:#087f76;display:grid;place-items:center;font-style:normal;font-size:9px;font-weight:700}.auto-step b{font-size:9px;color:#25444d}.auto-step small{font-size:7px;color:#5b7275}.step-line{height:12px;border-left:1px dashed #7ebbb0;margin-left:11px}.auto-step.outcome i{background:#087f76;color:white}.exception-pill{display:inline-block;margin:14px 0 0 31px;padding:5px 7px;background:#fff0dc;color:#865118;font-size:7px}
