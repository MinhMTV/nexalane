---
interface Props { kind?: 'hero' | 'automation' | 'integration' | 'custom' | 'maintenance' }
const { kind = 'hero' } = Astro.props;
const english = Astro.url.pathname.includes('/en/');
const copy = english ? {
  description: { hero: 'Operations dashboard connecting business systems and tracking order flow.', automation: 'Document workflow with automated validation and exception handling.', integration: 'System architecture linking ERP, CRM, an online store and a shared data layer.', custom: 'Order management workspace with filters, owners and current status.', maintenance: 'Application health monitor with service checks, release history and follow-up.' },
  source:'Order intake', flow:'WORKFLOW STATUS', pending:'Needs review', synced:'Synced', today:'TODAY', week:'THIS WEEK', requests:'Open requests', outstanding:'Awaiting review', latest:'Latest activity', processed:'Record created', checks:'Checks passed', manual:'Manual steps', copy:'Copy details', inbox:'Email inbox', spreadsheet:'Spreadsheet', target:'Business system', exception:'Exception queue', uptime:'SERVICE HEALTH', services:'Services', stable:'All checks passing', release:'Latest release', log:'Activity log'
} : {
  description: { hero: 'Prozessübersicht mit verbundenen Geschäftssystemen und nachvollziehbarem Auftragsfluss.', automation: 'Dokumentenablauf mit automatisierter Prüfung und sichtbarer Bearbeitung von Ausnahmen.', integration: 'Systemarchitektur mit ERP, CRM, Webshop und gemeinsamer Datendrehscheibe.', custom: 'Auftragsverwaltung mit Filtern, Zuständigkeiten und Statusübersicht.', maintenance: 'Anwendungsmonitoring mit Systemchecks, Versionsverlauf und offenen Aufgaben.' },
  source:'Auftragseingang', flow:'ABLAUFSTATUS', pending:'Prüfung nötig', synced:'Synchronisiert', today:'HEUTE', week:'DIESE WOCHE', requests:'Offene Aufträge', outstanding:'Warten auf Freigabe', latest:'Letzte Aktivität', processed:'Datensatz angelegt', checks:'Prüfungen erfüllt', manual:'Manuelle Schritte', copy:'Daten kopieren', inbox:'E-Mail-Postfach', spreadsheet:'Tabelle', target:'Fachsystem', exception:'Prüfwarteschlange', uptime:'SYSTEMSTATUS', services:'Dienste', stable:'Alle Checks erfolgreich', release:'Letzte Version', log:'Aktivitätsprotokoll'
};
---
<div class:list={['flow-visual', `flow-${kind}`]} role="img" aria-label={copy.description[kind]}>
  {kind === 'hero' && <>
    <div class="visual-top"><span class="window-dots"><i></i><i></i><i></i></span><span>NEXALANE / OPERATIONS</span><span class="live"><i></i> WORKFLOW</span></div>
    <div class="flow-canvas hero-canvas">
      <aside class="hero-rail"><b>N</b><i class="active"></i><i></i><i></i><i></i><span>◎</span></aside>
      <div class="hero-board"><div class="hero-board-head"><div><small>{copy.today} · 09:42</small><b>{copy.flow}</b></div><span>+ {english ? 'New request' : 'Neuer Auftrag'}</span></div>
        <div class="hero-stats"><div><small>{copy.requests}</small><b>18</b><i>{english ? '4 due today' : '4 heute fällig'}</i></div><div><small>{copy.outstanding}</small><b>03</b><i class="warn">{english ? '2 need input' : '2 brauchen Angaben'}</i></div><div><small>{copy.week}</small><b>42</b><i class="good">{english ? '↑ 6 completed' : '↑ 6 erledigt'}</i></div></div>
        <div class="hero-workflow"><div class="system-chip"><span class="chip-symbol mail">@</span><b>{copy.source}</b><small>{english ? 'Form + email' : 'Formular + E-Mail'}</small></div><div class="hero-link"><i></i><i></i><i></i></div><div class="system-chip"><span class="chip-symbol rules">✓</span><b>{english ? 'Validated' : 'Geprüft'}</b><small>{english ? 'Required fields' : 'Pflichtfelder'}</small></div><div class="hero-link"><i></i><i></i><i></i></div><div class="system-chip teal-chip"><span class="chip-symbol data">↗</span><b>{copy.target}</b><small>{copy.synced}</small></div></div>
        <div class="hero-last"><span class="last-dot"></span><b>{copy.latest}</b><span>{copy.processed}</span><small>09:41:28</small></div>
      </div>
    </div>
  </>}
  {kind === 'automation' && <>
    <div class="visual-top"><span class="window-dots"><i></i><i></i><i></i></span><span>{english ? 'DOCUMENT WORKFLOW' : 'DOKUMENTENABLAUF'}</span><span class="live"><i></i> {english ? 'VALIDATION' : 'PRÜFUNG'}</span></div>
    <div class="flow-canvas automation-canvas"><div class="manual-stack"><span class="lane-title">{copy.manual}</span><div class="loose-item">@ <span>{copy.inbox}</span></div><div class="loose-item">▤ <span>{copy.spreadsheet}</span></div><small>{copy.copy}</small></div><div class="transform-arrow" aria-hidden="true">→</div><div class="auto-lane"><span class="lane-title">{english ? 'AUTOMATED STEPS' : 'AUTOMATISIERTE SCHRITTE'}</span><div class="auto-step"><i>1</i><b>{english ? 'Capture' : 'Übernehmen'}</b><small>PDF · XML · Form</small></div><div class="step-line"></div><div class="auto-step"><i>2</i><b>{english ? 'Validate' : 'Validieren'}</b><small>{copy.checks}</small></div><div class="step-line"></div><div class="auto-step outcome"><i>✓</i><b>{copy.target}</b><small>{copy.synced}</small></div><div class="exception-pill">! {copy.exception} · {copy.pending}</div></div></div>
  </>}
  {kind === 'integration' && <>
    <div class="visual-top"><span class="window-dots"><i></i><i></i><i></i></span><span>{english ? 'SYSTEM MAP / DATA EXCHANGE' : 'SYSTEMÜBERSICHT / DATENAUSTAUSCH'}</span><span class="live"><i></i> API</span></div>
    <div class="flow-canvas integration-canvas"><svg class="integration-lines" viewBox="0 0 640 330" preserveAspectRatio="none" aria-hidden="true"><path d="M130 83 H265 M130 247 H265 M375 83 H510 M375 247 H510 M320 116 V214 M130 83 C195 83 205 165 265 165 M510 247 C445 247 435 165 375 165"/><path class="pulse-line" d="M130 83 H265 M375 83 H510"/></svg><div class="map-node erp"><span>01</span><b>ERP</b><small>{english?'Orders':'Aufträge'}</small></div><div class="map-node crm"><span>02</span><b>CRM</b><small>{english?'Accounts':'Kontakte'}</small></div><div class="map-node shop"><span>03</span><b>SHOP</b><small>{english?'Products':'Produkte'}</small></div><div class="map-node api-hub"><b>API</b><small>{english?'Rules · log':'Regeln · Protokoll'}</small></div><div class="map-node database"><span>04</span><b>DB</b><small>{english?'Data layer':'Datenhaltung'}</small></div><div class="map-node portal"><span>05</span><b>PORTAL</b><small>{english?'External service':'Externer Dienst'}</small></div><div class="map-foot"><span><i></i>{english?'Sync complete':'Abgleich erfolgt'}</span><b>REST · JSON · HTTPS</b></div></div>
  </>}
  {kind === 'custom' && <>
      <div class="visual-top"><span class="window-dots"><i></i><i></i><i></i></span><span>N / {english ? 'ORDER DESK' : 'AUFTRAGSBÜRO'}</span><span class="live">{english?'WORKFLOW':'ARBEITSABLAUF'}</span></div>
    <div class="flow-canvas custom-canvas"><aside class="custom-nav"><b>N</b><span class="selected">▦</span><span>⌕</span><span>◷</span><span>▤</span><small>⚙</small></aside><div class="custom-app"><header><span>{english?'Operations / Orders':'Arbeitsbereich / Aufträge'}</span><b>＋ {english?'Create order':'Auftrag anlegen'}</b></header><h3>{english?'Open orders':'Offene Aufträge'} <small>18</small></h3><div class="custom-controls"><span>{english?'All statuses':'Alle Status'}　⌄</span><span>⌕ {english?'Search orders':'Aufträge suchen'}</span><span>{english?'Filter':'Filter'}　☷</span></div><div class="custom-table"><div class="table-row table-head"><span>{english?'ORDER':'AUFTRAG'}</span><span>{english?'CUSTOMER':'KUNDE'}</span><span>{english?'OWNER':'ZUSTÄNDIG'}</span><span>{english?'STATUS':'STATUS'}</span></div><div class="table-row"><b>#1048</b><span>{english?'Customer':'Kunde'} A</span><span>MK</span><em>{english?'In progress':'In Arbeit'}</em></div><div class="table-row"><b>#1047</b><span>{english?'Customer':'Kunde'} B</span><span>JL</span><em class="waiting">{english?'Waiting':'Wartet'}</em></div><div class="table-row"><b>#1046</b><span>{english?'Customer':'Kunde'} C</span><span>MK</span><em>{english?'Review':'Prüfung'}</em></div><div class="table-row"><b>#1045</b><span>{english?'Customer':'Kunde'} D</span><span>FR</span><em>{english?'New':'Neu'}</em></div></div><footer>← {english?'Previous':'Zurück'} <span>1–4 {english?'of 18':'von 18'}</span> {english?'Next':'Weiter'} →</footer></div></div>
  </>}
  {kind === 'maintenance' && <>
    <div class="visual-top"><span class="window-dots"><i></i><i></i><i></i></span><span>{copy.uptime} / {english?'MONITORING':'MONITORING'}</span><span class="live"><i></i> {copy.stable}</span></div>
    <div class="flow-canvas maintenance-canvas"><div class="maintenance-header"><div><small>{english?'APPLICATION':'ANWENDUNG'}</small><b>Operations Portal</b></div><span class="stable-pill"><i></i>{english?'Operational':'In Betrieb'}</span></div><div class="health-grid"><div><i class="health-check">✓</i><b>API</b><small>34 ms</small></div><div><i class="health-check">✓</i><b>Database</b><small>Connected</small></div><div><i class="health-check">✓</i><b>Jobs</b><small>2 running</small></div></div><div class="maintenance-bottom"><div class="release-box"><small>{copy.release}</small><b>v2.8.1</b><span>{english?'Security updates · 2 days ago':'Sicherheitsupdates · vor 2 Tagen'}</span></div><div class="log-box"><small>{copy.log}</small><span><i class="ok"></i> 09:42 · {english?'Scheduled sync complete':'Abgleich abgeschlossen'}</span><span><i class="attention"></i> 09:17 · {english?'1 item needs review':'1 Eintrag zu prüfen'}</span></div></div><div class="code-rail"><span>09:42:08</span> INFO <b>sync.completed</b> <small>duration=284ms</small></div></div>
  </>}
</div>
<style>
 .flow-visual{--line:#c9d8d5;position:relative;overflow:hidden;border:1px solid #d2dfdb;background:#fbfcfb;color:#193247;box-shadow:0 26px 70px #122d3b24}.visual-top{height:43px;display:flex;align-items:center;gap:13px;border-bottom:1px solid #e4ece9;padding:0 15px;background:#fff;color:#526a70;font:600 8px/1 ui-monospace,monospace;letter-spacing:.1em}.window-dots{display:flex;gap:4px}.window-dots i{width:6px;height:6px;background:#c9d7d3;border-radius:50%}.live{margin-left:auto;color:#176b5d;font-size:7px;white-space:nowrap}.live i{display:inline-block;width:6px;height:6px;background:#36a587;border-radius:50%;margin-right:5px}.flow-canvas{height:365px;position:relative;overflow:hidden}.hero-canvas{display:flex;background:#f1f6f3}.hero-rail{width:42px;flex:none;background:#173d50;display:flex;align-items:center;flex-direction:column;gap:17px;padding:14px 0;color:#a7c5c2}.hero-rail b{font:700 10px var(--font-display);color:#fff;margin-bottom:8px}.hero-rail i{width:15px;height:15px;border:1px solid #6e9898}.hero-rail i.active{border-color:#8bd6c5;background:#1e665f}.hero-rail span{margin-top:auto;margin-bottom:9px}.hero-board{flex:1;min-width:0;padding:17px 19px}.hero-board-head{display:flex;justify-content:space-between;align-items:center}.hero-board-head div{display:grid;gap:4px}.hero-board-head small{font-size:8px;color:#526a70}.hero-board-head b{font:700 17px var(--font-display);color:#153a4c}.hero-board-head>span{background:#087f76;color:white;padding:8px 10px;font-size:8px}.hero-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin:17px 0}.hero-stats>div{display:grid;gap:5px;background:#fff;border:1px solid #dfe9e4;padding:10px}.hero-stats small{font-size:8px;color:#536a70}.hero-stats b{font:700 21px var(--font-display);color:#193f50}.hero-stats i{font-style:normal;font-size:7px;color:#456c65}.hero-stats i.warn{color:#a35e1b}.hero-workflow{display:flex;align-items:center;justify-content:center;gap:9px;background:#fff;border:1px solid #dfe9e4;padd