---
interface Props { lang: 'de' | 'at' | 'en' }
const { lang } = Astro.props;
const german = lang !== 'en';
const cases = german ? [
  ['Zeiterfassung','Time tracking','Operations / Woche 24'],['Auftragsverwaltung','Orders / Aufträge','Offene Vorgänge'],['Lager & Inventar','Inventory / Lager','Bestandsübersicht'],
  ['Dokumentenverarbeitung','Document flow','Eingangsprüfung'],['Reporting','Business reporting','Monatsauswertung'],['API-Synchronisierung','Data sync','Letzte Synchronisierung'],
] : [
  ['Time tracking','Time tracking','Operations / Week 24'],['Order management','Orders / Queue','Open requests'],['Inventory','Inventory / Stock','Stock overview'],
  ['Document processing','Document flow','Incoming review'],['Reporting','Business reporting','Monthly overview'],['API synchronisation','Data sync','Last synchronisation'],
];
---
<section class="use-cases">
  <div class="use-head"><span class="eyebrow"><i></i>{german?'SOFTWARE FÜR IHRE ABLÄUFE':'SOFTWARE FOR YOUR WORKFLOWS'}</span><h2>{german?'Werkzeuge für den konkreten Ablauf.':'Tools shaped around the workflow.'}</h2><p>{german?'Aufträge steuern, Dokumente prüfen, Bestände abgleichen und Daten auswerten – mit Software, die Ihre Arbeitsschritte abbildet.':'Manage orders, review documents, reconcile stock and understand your data with software built around the way you work.'}</p></div>
  <div class="use-grid">
    {cases.map(([name,app,caption],index)=><article class="use-case">
      <div class:list={['mini-app', `app-${index+1}`]} role="img" aria-label={`${name} – ${german?'Arbeitsübersicht':'workflow overview'}`}>
        <div class="mini-sidebar"><span class="mini-logo"></span><i></i><i></i><i></i><i></i><i></i><b></b></div>
        <div class="mini-main"><div class="mini-top"><span>{app}</span><i></i></div><div class="mini-title">{caption}</div>
          {index===0 && <><div class="mini-week"><b>24</b><span>MON</span><b>7,5<small>h</small></b><span>DIENSTAG</span><b>6,0<small>h</small></b></div><div class="mini-bars"><i style="--h:54%"></i><i style="--h:83%"></i><i style="--h:68%"></i><i style="--h:93%"></i><i style="--h:62%"></i><i style="--h:74%"></i><i style="--h:49%"></i></div></>}
          {index===1 && <><div class="mini-table"><b>ID <span>Status</span><em>Termin</em></b><i>#1048 <span>In Bearbeitung</span><em>12. Jun</em></i><i>#1047 <span>Prüfung</span><em>12. Jun</em></i><i>#1046 <span>Abgeschlossen</span><em>11. Jun</em></i></div></>}
          {index===2 && <><div class="mini-kpis"><b>1.284<small>Artikel</small></b><b>18<small>Niedrigbestand</small></b></div><div class="mini-stock"><i></i><span>Komponente A</span><b>72</b><i></i><span>Modul B</span><b>18</b></div></>}
          {index===3 && <><div class="mini-doc"><span>PDF</span><div><b>Rechnung #2084</b><small>12 Felder erkannt · geprüft</small></div><i>✓</i></div><div class="mini-doc"><span>XML</span><div><b>Bestellung #1048</b><small>Zuordnung erforderlich</small></div><i>↗</i></div></>}
          {index===4 && <><div class="mini-report"><b>€ 84.290<small>Umsatz · laufender Monat</small></b><span>+8,4%</span></div><div class="mini-spark"><svg viewBox="0 0 220 60" preserveAspectRatio="none" aria-hidden="true"><path d="M0 48 C22 42 22 50 48 36 S77 41 102 27 S133 38 157 18 S185 29 220 5" fill="none" stroke="#087f76" stroke-width="3"/><path d="M0 58H220" stroke="#dde8e4"/></svg></div></>}
          {index===5 && <><div class="mini-sync"><div><b>ERP</b><small>128 Datensätze</small></div><span>⇄</span><div><b>CRM</b><small>Synchronisiert</small></div></div><div class="mini-sync-status"><i></i>{german?'Aktuell':'Up to date'} <span>10:42:08</span></div></>}
        </div>
      </div><div class="use-caption"><span>0{index+1}</span><h3>{name}</h3><span aria-hidden="true">↗</span></div>
    </article>)}
  </div>
</section>
<style>
 .use-cases{max-width:var(--page);margin:auto;padding:70px 24px 95px}.use-head{display:grid;grid-template-columns:1fr .6fr;column-gap:45px;align-items:end;margin-bottom:30px}.use-head .eyebrow{grid-column:1/-1}.use-head h2{font:700 clamp(33px,4vw,47px)/1.1 var(--font-display);letter-spacing:-.05em;color:var(--navy);margin:15px 0 0}.use-head p{font-size:12px;line-height:1.8;color:#566b70;margin:0 0 3px}.use-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px 18px}.use-case{min-width:0}.mini-app{height:192px;display:flex;background:#fbfcfc;border:1px solid #dce6e2;color:#34505a;overflow:hidden;font:9px var(--font-body);box-shadow:0 8px 22px #19384809}.mini-sidebar{width:36px;background:#eff4f2;border-right:1px solid #e4ebe8;display:flex;align-items:center;flex-direction:column;gap:13px;padding:12px 0;flex:none}.mini-sidebar i{width:11px;height:2px;background:#a8b8b6}.mini-sidebar b{margin-top:auto;width:14px;height:14px;border-radius:50%;background:#d4e3de}.mini-logo{width:14px;height:14px;background:var(--teal);position:relative;margin-bottom:8px}.mini-logo::after{content:'';position:absolute;width:4px;height:4px;right:-2px;bottom:-2px;background:#9ed8cd;border:1px solid white}.mini-main{padding:13px 13px 10px;flex:1;min-width:0}.mini-top{display:flex;justify-content:space-between;align-items:center;color:#52696e;font:8px ui-monospace,monospace}.mini-top i{width:12px;height:12px;background:#e9efec;border-radius:50%}.mini-title{color:#203e4c;font:700 12px var(--font-display);margin:13px 0 10px}.mini-week{display:grid;grid-template-columns:22px 1fr 35px;align-items:center;gap:3px 6px}.mini-week>b{font:700 11px var(--font-display);color:#265364}.mini-week>b small{font:8px var(--font-body);margin-left:2px}.mini-week>span{font:7px ui-monospace,monospace;color:#53696e}.mini-bars{height:54px;margin-top:11px;display:flex;align-items:end;gap:8px;border-bottom:1px solid #dfe8e4}.mini-bars i{flex:1;height:var(--h);background:#a9d5cc}.mini-bars i:nth-child(3n){background:#398f81}.mini-table{font-size:7px;color:#547079}.mini-table b,.mini-table i{display:grid;grid-template-columns:.55fr 1fr .6fr;padding:5px 0;border-bottom:1px solid #e7eeeb;font-style:normal}.mini-table b{color:#566c70}.mini-table span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.mini-table em{text-align:right;font-style:normal}.mini-kpis{display:grid;grid-template-columns:1fr 1fr;gap:8px}.mini-kpis b{font:700 14px var(--font-display);color:#276052;padding:9px 7px;background:#eff5f2}.mini-kpis small{display:block;font:7px var(--font-body);color:#52686c}.mini-stock{display:grid;grid-template-columns:8px 1fr 20px;gap:8px;align-items:center;margin-top:11px;font-size:8px;color:#53696e}.mini-stock i{width:5px;height:5px;background:#48a384;border-radius:50%}.mini-stock b{text-align:right;color:#23434e}.mini-doc{display:flex;align-items:center;gap:7px;padding:8px 0;border-bottom:1px solid #e7eeeb}.mini-doc>span{width:25px;height:29px;background:#f3eae7;display:grid;place-items:center;font:7px ui-monospace,monospace;color:#75493b}.mini-doc div{min-width:0;flex:1}.mini-doc b,.mini-doc small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mini-doc b{font-size:8px}.mini-doc small{color:#566a6e;font-size:7px;margin-top:3px}.mini-doc>i{font-style:normal;color:#309477}.mini-report{display:flex;justify-content:space-between;align-items:start}.mini-report>b{font:700 15px var(--font-display);color:#24515a}.mini-report small{display:block;font:7px var(--font-body);color:#536a6f}.mini-report>span{font-size:7px;color:#176b50;background:#e8f4ed;padding:3px 5px}.mini-spark{height:65px;margin-top:8px}.mini-spark svg{width:100%;height:100%}.mini-sync{display:flex;justify-content:space-between;align-items:center;margin:18px 4px 13px}.mini-sync>div{padding:9px 8px;border:1px solid #e1eae6;background:white;min-width:75px;text-align:center}.mini-sync b,.mini-sync small{display:block}.mini-sync b{font:700 9px ui-monospace,monospace;color:#2a6f67}.mini-sync small{font-size:7px;color:#536a6f;margin-top:3px}.mini-sync>span{color:var(--teal);font-size:16px}.mini-sync-status{padding:7px;background:#edf5f1;color:#3f645d;font-size:7px}.mini-sync-status i{display:inline-block;width:5px;height:5px;border-radius:50%;background:#40a37f;margin-right:5px}.mini-sync-status span{float:right;font-family:ui-monospace,monospace}.use-caption{display:grid;grid-template-columns:30px 1fr 18px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}.use-caption>span:first-child{color:#536a70;font:8px ui-monospace,monospace}.use-caption h3{font:700 13px var(--font-display);color:var(--navy);margin:0}.use-caption>span:last-child{justify-self:end;color:#869899}
 @media(max-width:900px){.use-cases{padding:50px 20px 65px}.use-grid{grid-template-columns:repeat(2,1fr)}.use-head{grid-template-columns:1fr;gap:10px}.use-head p{max-width:450px}}
 @media(max-width:480px){.use-grid{grid-template-columns:1fr;gap:13px}.mini-app{height:205px}.use-case{display:grid;grid-template-columns:1fr}.use-caption h3{font-size:14px}}
</style>

