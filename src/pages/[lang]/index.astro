---
import SiteLayout from '../../layouts/SiteLayout.astro';
import FlowVisual from '../../components/FlowVisual.astro';
import WhyAvernode from '../../components/WhyAvernode.astro';
import SavingsCalculator from '../../components/SavingsCalculator.astro';
import { content, type Language } from '../../content/pages';
import { pagePath } from '../../lib/paths';
export function getStaticPaths() { return [{ params: { lang: 'de' } }, { params: { lang: 'en' } }]; }
const lang = Astro.params.lang as Language;
const c = content[lang];
const p = c.pages.home;
const description = lang === 'de'
  ? 'Individuelle Software, Prozessautomatisierung und Systemintegration aus Wien. AVERNODE reduziert manuelle Arbeit und verbindet Ihre bestehenden Systeme.'
  : 'Custom software, workflow automation and system integration from Vienna. AVERNODE reduces manual work and connects your existing systems.';
const seoTitle = lang === 'de' ? 'Individuelle Software & Automatisierung in Wien' : 'Custom Software & Automation in Vienna';
const pictograms: Record<string,string> = {custom:'▤',automation:'↻',integration:'⌘',maintenance:'◌'};
---
<SiteLayout lang={lang} page="home" title={seoTitle} description={description}>
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy"><span class="eyebrow"><i></i>{p.eyebrow}</span><h1>{p.title}</h1><p class="hero-intro">{p.intro}</p><div class="hero-actions"><a class="button-primary" href={pagePath(lang,'solutions')}>{p.primary}<span aria-hidden="true">↗</span></a><a class="text-link" href={pagePath(lang,'contact')}>{p.secondary}<span aria-hidden="true"> →</span></a></div><div class="hero-proof"><span class="proof-rule"></span>{p.proof}</div></div>
      <div class="hero-art"><div class="art-caption"><span>01 / 04</span><span>BUSINESS SYSTEMS · CONNECTED</span></div><FlowVisual /></div>
    </div>
    <div class="hero-coordinate" aria-hidden="true">48°12' N&nbsp;&nbsp; 16°22' E <span>VIENNA / AT</span></div>
  </section>
  <section class="services section-pad">
    <div class="section-heading"><div><span class="eyebrow"><i></i>{p.sectionLabel}</span><h2>{p.sectionTitle}</h2></div><p>{p.sectionIntro}</p></div>
    <div class="service-list">{p.services.map(([number,title,copy,kind])=><a class="service-row" href={pagePath(lang,'services')}><span class="service-number">{number}</span><span class="service-icon" aria-hidden="true">{pictograms[kind]}</span><span class="service-text"><b>{title}</b><small>{copy}</small></span><span class="service-arrow" aria-hidden="true">↗</span></a>)}</div>
  </section>
  <section class="project-teaser"><div><h2>{lang==='de'?'Was ändert sich im Arbeitsalltag?':'What changes in everyday work?'}</h2><p>{lang==='de'?'Sehen Sie an Rechnungen, Angeboten und Belegen, welche Handgriffe automatisiert werden können – inklusive transparenter Beispielrechnung zur möglichen Zeitersparnis.':'See how invoices, quotes and receipts can be handled with less manual work, with a transparent calculation of potential time savings.'}</p></div><a href={pagePath(lang,'solutions')}>{lang==='de'?'Projektbeispiele ansehen':'View project examples'} <span>↗</span></a></section>
  <WhyAvernode lang={lang} />
  <section class="visual-section"><div class="visual-copy"><span class="eyebrow light"><i></i>{p.visualLabel}</span><h2>{p.visualTitle}</h2><p>{lang==='de'?'Eingang aus Formular oder E-Mail erfassen, Pflichtangaben prüfen und konsistent ins Fachsystem übertragen. Unklare Fälle bleiben zur Freigabe sichtbar.':'Capture requests from forms or email, validate required fields and transfer them to the business system. Unclear cases stay visible for review.'}</p><a class="line-link" href={pagePath(lang,'services')}>{c.nav.services}<span> →</span></a></div><div class="visual-art"><FlowVisual kind="integration" /></div><span class="vertical-index">AV / SYSTEMS / 01</span></section>
  <section class="process-section section-pad"><div class="process-heading"><span class="eyebrow"><i></i>{p.processLabel}</span><h2>{p.processTitle}</h2><a class="text-link" href={pagePath(lang,'process')}>{lang==='de'?'Unser Vorgehen':'How we work'} <span>→</span></a></div><div class="steps">{p.steps.map(([num,title,copy])=><div class="step"><span>{num}</span><h3>{title}</h3><p>{copy}</p><i></i></div>)}</div></section>
  <SavingsCalculator lang={lang} />
  <section class="final-cta"><div><span class="eyebrow light"><i></i>{lang==='de'?'DER NÄCHSTE SCHRITT':'NEXT STEP'}</span><h2>{p.finalTitle}</h2><p>{p.finalCopy}</p></div><a href={pagePath(lang,'contact')} class="button-light">{c.cta}<span>↗</span></a></section>
</SiteLayout>
<style>
 .project-teaser{max-width:var(--page);margin:0 auto;padding:48px 24px;display:flex;align-items:center;justify-content:space-between;gap:35px;border-bottom:1px solid #d5e0dc}.project-teaser h2{font:700 clamp(28px,3vw,37px)/1.12 var(--font-display);letter-spacing:-.04em;color:var(--navy);margin:0 0 9px}.project-teaser p{font-size:13px;line-height:1.75;color:#405b63;max-width:650px;margin:0}.project-teaser>a{white-space:nowrap;color:#075f59;font-size:12px;font-weight:700;text-decoration-thickness:1px;text-underline-offset:5px}
 @media(max-width:700px){.project-teaser{display:block;padding:37px 20px}.project-teaser>a{display:inline-block;margin-top:18px}}
 .hero{position:relative;background:#14384b;min-height:650px;padding:46px 24px 55px;overflow:hidden}.hero::before{content:'';position:absolute;inset:0 0 auto 57%;height:100%;background:linear-gradient(90deg,#14384b00,#17606a55);pointer-events:none}.hero-inner{position:relative;max-width:var(--page);margin:auto;display:grid;grid-template-columns:.85fr 1.15fr;gap:60px;align-items:center;min-height:540px}.hero-copy{padding:15px 0 24px;max-width:490px;animation:rise .65s ease-out both}.eyebrow{display:flex;align-items:center;gap:9px;color:#58717a;font:700 9px/1.4 ui-monospace,monospace;letter-spacing:.15em}.eyebrow i{width:17px;height:1px;background:var(--teal)}.hero h1,.section-heading h2,.visual-copy h2,.process-heading h2,.decision-copy h2,.final-cta h2,.page-intro h1{font-family:var(--font-display);color:var(--navy);letter-spacing:-.055em;line-height:1.07}.hero .eyebrow{color:#cce2de}.hero .eyebrow i{background:#50c5b1}.hero h1{font-size:clamp(46px,5.35vw,72px);margin:25px 0 20px;max-width:540px;color:#fff}.hero-intro{max-width:455px;color:#d0e0df;font-size:15px;line-height:1.8}.hero-actions{display:flex;align-items:center;gap:25px;margin-top:28px}.hero-actions .button-primary{padding:14px 18px;background:#0c9486;border-color:#0c9486}.hero-actions .button-primary:hover{background:#08786e}.hero .text-link{color:#fff}.hero .text-link:hover{color:#8de0d2}.hero-proof{display:flex;align-items:center;gap:12px;color:#b4c9c9;font:9px ui-monospace,monospace;margin-top:44px}.proof-rule{width:27px;height:1px;background:#50a69b}.hero-art{position:relative;animation:rise .8s .12s ease-out both}.hero-art .flow-visual{transform:perspective(1500px) rotateY(-2deg);transform-origin:center;}.art-caption{display:flex;justify-content:space-between;padding:0 0 11px;color:#c1d6d2;font:8px ui-monospace,monospace;letter-spacing:.1em}.hero-coordinate{position:absolute;left:calc((100% - var(--page))/2);bottom:15px;color:#b4c9c9;font:8px ui-monospace,monospace;letter-spacing:.1em}.hero-coordinate span{margin-left:10px;color:#c3d5d2}.section-pad{max-width:var(--page);margin:auto;padding:100px 24px}.section-heading{display:grid;grid-template-columns:1fr .65fr;gap:80px;align-items:end;margin-bottom:49px}.section-heading h2,.process-heading h2{font-size:clamp(34px,4.2vw,52px);max-width:620px;margin:18px 0 0}.section-heading p{font-size:13px;line-height:1.8;color:#526b70;margin:0 0 3px;max-width:390px}.service-list{border-top:1px solid var(--line)}.service-row{display:grid;grid-template-columns:55px 62px 1fr 35px;align-items:center;gap:16px;min-height:112px;border-bottom:1px solid var(--line);text-decoration:none;transition:padding .25s,background .25s}.service-row:hover{padding:0 14px;background:#eff6f3}.service-number{font:10px ui-monospace,monospace;color:#526b70}.service-icon{display:grid;place-items:center;width:43px;height:43px;border:1px solid #b9d2ca;color:#087f76;background:#e4f2ee;font-size:20px}.service-text b{display:block;color:var(--navy);font:700 18px var(--font-display);letter-spacing:-.02em}.service-text small{display:block;color:#4d656b;font-size:12px;margin-top:4px}.service-arrow{justify-self:end;color:#527579;font-size:19px}.visual-section{position:relative;display:grid;grid-template-columns:.78fr 1.22fr;gap:60px;align-items:center;background:var(--navy);padding:76px max(24px,calc((100% - var(--page))/2));min-height:550px;overflow:hidden}.visual-copy{max-width:390px}.eyebrow.light{color:#d7eee9}.visual-copy h2{color:#f7fbfa;font-size:clamp(35px,4.4vw,53px);margin:20px 0}.visual-copy p{color:#b5c6c8;font-size:13px;line-height:1.8}.line-link{display:inline-block;color:#89d0c5;text-decoration:none;border-bottom:1px solid #527a7c;padding:0 0 6px;margin-top:19px;font-size:12px;font-weight:700}.visual-art{min-width:0}.visual-art .flow-visual{box-shadow:0 25px 65px #06172466}.vertical-index{position:absolute;right:23px;top:50%;writing-mode:vertical-rl;color:#a0babc;font:8px ui-monospace,monospace;letter-spacing:.15em}.process-section{padding-top:100px;padding-bottom:105px}.process-heading{display:grid;grid-template-columns:1fr auto;align-items:end}.process-heading .eyebrow{grid-column:1/-1}.process-heading .text-link{margin-bottom:8px}.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:52px}.step{position:relative;padding:0 23px 0 0;margin-right:23px;border-top:1px solid #b8cbc6}.step>span{display:inline-block;margin-top:17px;color:#087f76;font:11px ui-monospace,monospace}.step h3{font:700 17px var(--font-display);color:var(--navy);margin:14px 0 7px}.step p{font-size:12px;line-height:1.75;color:#4e666d;margin:0;max-width:230px}.step i{position:absolute;top:-3px;left:0;width:5px;height:5px;background:#0c9486;border-radius:50%}.decision{max-width:var(--page);margin:0 auto 105px;padding:0 24px;display:grid;grid-template-columns:1fr .8fr;gap:100px;align-items:center}.decision-visual{border:1px solid #e0e8e5;background:#fbfcfc;padding:20px 22px}.chart-head{display:flex;justify-content:space-between;color:#596f74;font:8px ui-monospace,monospace;letter-spacing:.1em}.chart-area{height:195px;position:relative;margin-top:19px;padding-left:25px}.chart-area svg{width:100%;height:100%;position:relative;z-index:2}.gridline{position:absolute;left:25px;right:0;border-top:1px solid #e9efed}.gridline.one{top:33%}.gridline.two{top:66%}.gridline.three{top:99%}.y-label{position:absolute;left:0;color:#627579;font:8px ui-monospace,monospace}.y1{top:27%}.y2{bottom:-2px}.x-labels{display:flex;justify-content:space-between;color:#63777a;font:8px ui-monospace,monospace}.chart-legend{display:flex;gap:20px;margin:18px 0 0 25px;color:#526a70;font-size:9px}.chart-legend span{display:flex;align-items:center;gap:6px}.chart-legend i{width:17px;border-top:2px dashed #7994a0}.chart-legend i.custom-line{border-top:2px solid #0b897b}.decision-copy h2{font-size:clamp(33px,4vw,47px);margin:20px 0}.decision-copy p{font-size:13px;color:#63777d;line-height:1.85;margin-bottom:24px}.final-cta{background:#08796f;color:white;padding:62px max(24px,calc((100% - var(--page))/2));display:flex;justify-content:space-between;align-items:center;gap:45px}.final-cta h2{font-size:clamp(34px,4.2vw,50px);color:#fff;margin:16px 0 10px}.final-cta p{color:#e0f0ed;margin:0;max-width:560px;font-size:13px}.button-light{display:inline-flex;white-space:nowrap;gap:12px;padding:13px 18px;background:#fff;color:#13564f;text-decoration:none;font-size:12px;font-weight:700}.button-light:hover{background:#e8f4f1}
 .hero .text-link{white-space:nowrap}
 @keyframes rise{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
 @media(max-width:900px){.hero-inner{grid-template-columns:1fr 1fr;gap:24px}.hero h1{font-size:clamp(38px,5.2vw,48px);max-width:440px}.hero-copy{max-width:390px}.visual-section{gap:30px;padding-left:35px;padding-right:35px}.decision{gap:45px}}
 @media(max-width:700px){.hero{padding:43px 20px 55px}.hero-inner{grid-template-columns:1fr;gap:33px;min-height:0}.hero-copy{max-width:560px;padding:0}.hero h1{font-size:clamp(43px,11vw,60px);max-width:500px;margin:19px 0 16px}.hero-intro{font-size:14px}.hero-proof{margin-top:25px}.hero-art{margin:0 -3px}.hero-coordinate{left:20px;bottom:14px}.section-pad{padding:68px 20px}.section-heading{grid-template-columns:1fr;gap:14px;margin-bottom:30px}.section-heading h2,.process-heading h2{font-size:37px}.service-row{grid-template-columns:30px 43px 1fr 20px;gap:10px;min-height:100px}.service-icon{width:38px;height:38px}.service-text b{font-size:15px}.service-text small{font-size:11px;line-height:1.5}.visual-section{grid-template-columns:1fr;gap:30px;padding:58px 20px 63px}.visual-copy h2{font-size:40px;max-width:410px}.vertical-index{right:8px}.process-heading{grid-template-columns:1fr;gap:17px}.process-heading .text-link{margin-top:1px}.steps{grid-template-columns:1fr 1fr;row-gap:33px;margin-top:34px}.step{margin-right:16px}.decision{grid-template-columns:1fr;gap:35px;padding:0 20px;margin:0 auto 70px}.final-cta{padding:48px 20px;display:block}.final-cta h2{font-size:38px}.button-light{margin-top:23px}}
 @media(max-width:420px){.hero-actions{gap:17px;flex-wrap:wrap}.hero-actions .button-primary{padding:12px 14px}.steps{grid-template-columns:1fr}.step p{max-width:340px}.decision-visual{padding:16px 12px}.chart-legend{gap:11px;margin-left:18px;font-size:8px}}
</style>

