---
import SiteLayout from '../../layouts/SiteLayout.astro';
import FlowVisual from '../../components/FlowVisual.astro';
import PracticalProjects from '../../components/PracticalProjects.astro';
import ContactForm from '../../components/ContactForm.astro';
import { content, slugs, type Language, type PageKey } from '../../content/pages';
import { pagePath } from '../../lib/paths';
import { business } from '../../config/business';
export function getStaticPaths() {
  const keys: PageKey[] = ['services','solutions','process','about','contact','legal'];
  return (['de','at','en'] as const).flatMap(lang => keys.map(page => ({ params: { lang, slug: slugs[lang][page] }, props: { lang, page } })));
}
const { lang, page } = Astro.props as { lang: Language; page: PageKey };
const c = content[lang];
const p = c.pages[page] as { eyebrow: string; title: string; intro: string };
const services = c.pages.services;
const process = c.pages.process;
const about = c.pages.about;
const descriptions: Record<PageKey,string> = {
  services: lang!=='en'?'Individuelle Software, Automatisierung, Systemintegration und Modernisierung für Unternehmen.':'Custom software, automation, system integration and modernisation for businesses.',
  solutions: lang!=='en'?'Praxisnahe Automatisierungsbeispiele für Zeiterfassung, Excel-Listen, Reports und Rechnungen.':'Practical automation examples for time tracking, spreadsheets, reports and invoices.',
  process: lang!=='en'?'Ein transparentes Vorgehen von der Prozessanalyse bis zur sauberen Übergabe.':'A transparent process from workflow discovery through to a thoughtful handover.',
  about: lang!=='en'?'Nexalane entwickelt individuelle Software und Automatisierung aus Wien.':'Nexalane builds custom software and automation from Vienna, Austria.',
  contact: lang!=='en'?'Sprechen Sie mit Nexalane über Ihren Prozess und eine passende digitale Lösung.':'Talk to Nexalane about your workflow and a suitable digital solution.',
  legal: lang!=='en'?'Anbieter- und rechtliche Informationen zu Nexalane.':'Provider and legal information for Nexalane.', home:''
};
const title = 'title' in p ? p.title : page==='legal' ? (lang!=='en'?'Impressum':'Legal notice') : c.nav[page];
---
<SiteLayout lang={lang} page={page} title={title} description={descriptions[page]}>
  <section class="page-hero"><div class="page-hero-inner"><span class="eyebrow"><i></i>{p.eyebrow}</span><h1>{p.title}</h1>{p.intro && <p>{p.intro}</p>}<div class="page-hero-meta"><span>NEXALANE / {page.toUpperCase()}</span><span>{lang==='de'?'GERMANY':lang==='at'?'AUSTRIA':'VIENNA · AT'}</span></div></div></section>
  {page === 'services' && <section class="service-detail">{services.sections.map(([name,headline,copy,kind],index)=><article class:list={['detail-row', { reverse:index%2===1 }]}><div class="detail-copy"><span class="detail-index">0{index+1} / CAPABILITY</span><h2>{headline}</h2><p>{copy}</p><a href={pagePath(lang,'contact')} class="text-link">{c.cta} <span>→</span></a></div><div class="detail-visual"><span class="visual-label">{name.toUpperCase()}</span><FlowVisual kind={kind as 'automation'|'integration'|'custom'|'maintenance'} /></div></article>)}</section>}
  {page === 'services' && <section class="services-project-link"><div><h2>{lang!=='en'?'Wo geht im Alltag Zeit verloren?':'Where does everyday work lose time?'}</h2><p>{lang!=='en'?'Die Projektbeispiele zeigen, wie manuelle Zeiterfassung, Excel-Listen, Wochenreports und Rechnungen zu einfacheren Abläufen werden.':'The project examples show how manual time tracking, spreadsheets, weekly reports and invoices can become simpler workflows.'}</p></div><a class="button-primary" href={pagePath(lang,'solutions')}>{lang!=='en'?'Projektbeispiele ansehen':'View project examples'} <span>↗</span></a></section>}
  {page === 'solutions' && <PracticalProjects lang={lang} />}
  {page === 'services' && <section class="note-band"><div><span class="eyebrow light"><i></i>{lang!=='en'?'ENTSCHEIDUNG MIT AUGENMASS':'A MEASURED CHOICE'}</span><h2>{services.noteTitle}</h2></div><p>{services.noteCopy}</p></section>}
  {page === 'process' && <section class="approach"><div class="approach-list">{process.steps.map(([number,name,copy])=><article class="approach-step"><span class="approach-number">{number}</span><div><h2>{name}</h2><p>{copy}</p></div><div class="approach-mark" aria-hidden="true">↗</div></article>)}</div><aside class="principle"><span class="eyebrow light"><i></i>{lang!=='en'?'ERGEBNISSE JE ETAPPE':'DELIVERABLES AT EACH STAGE'}</span><h2>{lang!=='en'?'Sie sehen, was entsteht.':'See what takes shape.'}</h2><p>{lang!=='en'?'Jeder Schritt liefert eine greifbare Grundlage für die nächste Entscheidung.':'Each step produces something concrete to guide the next decision.'}</p><ol class="deliverables"><li><span>01</span><div><b>{lang!=='en'?'Prozessbild':'Workflow map'}</b><small>{lang!=='en'?'Abläufe, Systeme und Engpässe':'Steps, systems and bottlenecks'}</small></div></li><li><span>02</span><div><b>{lang!=='en'?'Klarer Lieferumfang':'Defined scope'}</b><small>{lang!=='en'?'Prioritäten, Aufwand und erste Etappe':'Priorities, effort and first milestone'}</small></div></li><li><span>03</span><div><b>{lang!=='en'?'Lauffähige Ergebnisse':'Working increments'}</b><small>{lang!=='en'?'Früh testen und gemeinsam schärfen':'Test early and refine together'}</small></div></li><li><span>04</span><div><b>{lang!=='en'?'Nachvollziehbare Übergabe':'Documented handover'}</b><small>{lang!=='en'?'Zugriff, Betrieb und nächste Schritte':'Access, operations and next steps'}</small></div></li></ol></aside></section>}
  {page === 'about' && <section class="about-content"><div class="about-lead"><span class="about-index">01 / OUR VIEW</span><h2>{about.copyTitle}</h2></div><div class="about-story"><p>{about.copy}</p><div class="principles">{about.principles.map(([name,copy])=><div><span>—</span><h3>{name}</h3><p>{copy}</p></div>)}</div></div><div class="location-band"><span class="location-icon" aria-hidden="true">⌖</span><p>{about.location}</p><span class="location-coord">48°12' N&nbsp; 16°22' E</span></div></section>}
  {page === 'contact' && <section class="contact-layout"><div class="contact-brief"><span class="eyebrow"><i></i>{lang!=='en'?'PROJEKTANFRAGE':'PROJECT ENQUIRY'}</span><h2>{lang!=='en'?'Was soll besser laufen?':'What should work better?'}</h2><p>{lang!=='en'?'Schreiben Sie kurz, welcher Ablauf Zeit kostet, welche Systeme beteiligt sind und was sich ändern soll.':'Tell us briefly which workflow takes too much time, which systems are involved and what you would like to change.'}</p><ul><li>{lang!=='en'?'Wiederkehrende manuelle Schritte':'Recurring manual steps'}</li><li>{lang!=='en'?'Daten, die mehrfach erfasst werden':'Data entered more than once'}</li><li>{lang!=='en'?'Systeme, die zusammenspielen sollen':'Systems that need to work together'}</li></ul><div class="direct-contact"><a href={`mailto:${business.email}`}>{business.email}</a>{business.phone && <a href={`tel:${business.phone.replaceAll(' ', '')}`}>{business.phone}</a>}</div></div><ContactForm lang={lang} recipient={business.email} /></section>}
  {page === 'legal' && <section class="legal-content"><dl>{business.legalName && <div><dt>{lang!=='en'?'Anbieter':'Provider'}</dt><dd>{business.legalName}</dd></div>}{business.address.street && <div><dt>{lang!=='en'?'Geschäftsanschrift':'Business address'}</dt><dd>{[business.address.street,business.address.postalCode,business.address.city,business.address.country].filter(Boolean).join(', ')}</dd></div>}{business.email && <div><dt>{lang!=='en'?'E-Mail':'Email'}</dt><dd><a href={`mailto:${business.email}`}>{business.email}</a></dd></div>}{business.phone && <div><dt>{lang!=='en'?'Telefon':'Phone'}</dt><dd><a href={`tel:${business.phone.replaceAll(' ', '')}`}>{business.phone}</a></dd></div>}{business.registration.companyRegister && <div><dt>{lang!=='en'?'Firmenbuch':'Company register'}</dt><dd>{business.registration.companyRegister}</dd></div>}{business.registration.vatId && <div><dt>{lang!=='en'?'Umsatzsteuer-ID':'VAT ID'}</dt><dd>{business.registration.vatId}</dd></div>}{(business.registration.chamber || business.registration.authority) && <div><dt>{lang!=='en'?'Kammer / Aufsichtsbehörde':'Chamber / authority'}</dt><dd>{[business.registration.chamber,business.registration.authority].filter(Boolean).join(' · ')}</dd></div>}</dl></section>}
  {page !== 'legal' && <section class="page-bottom"><span class="eyebrow"><i></i>{lang!=='en'?'WEITERDENKEN':'KEEP MOVING'}</span><h2>{lang!=='en'?'Lassen Sie uns den nächsten Schritt klären.':'Let’s work out the next step.'}</h2><a class="button-primary" href={pagePath(lang,'contact')}>{c.cta}<span>↗</span></a></section>}
</SiteLayout>
<style>
 @media(max-width:650px){.services-project-link{display:block;padding:34px 20px}.services-project-link .button-primary{margin-top:19px}}
 .services-project-link{background:#e9f2ef;padding:42px max(24px,calc((100% - var(--page))/2));display:flex;align-items:center;justify-content:space-between;gap:30px}.services-project-link h2{font:700 29px/1.15 var(--font-display);color:var(--navy);letter-spacing:-.035em;margin:0 0 8px}.services-project-link p{font-size:13px;line-height:1.75;color:#405b63;max-width:590px;margin:0}.services-project-link .button-primary{flex:none}
 .page-hero{background:#e5f0ec;padding:77px 24px 65px;border-bottom:1px solid #cbdad5}.page-hero-inner{max-width:var(--page);margin:auto}.page-hero h1{font-size:clamp(48px,7vw,78px);max-width:860px;margin:20px 0 17px}.page-hero p{color:#405b63;max-width:650px;font-size:15px;line-height:1.8}.page-hero-meta{display:flex;gap:30px;margin-top:36px;color:#405d63;font:8px ui-monospace,monospace;letter-spacing:.13em}
 .service-detail{max-width:var(--page);margin:auto;padding:20px 24px 55px}.detail-row{display:grid;grid-template-columns:.74fr 1.26fr;gap:75px;align-items:center;padding:67px 0;border-bottom:1px solid var(--line)}.detail-row.reverse{grid-template-columns:1.26fr .74fr}.detail-row.reverse .detail-copy{order:2}.detail-row.reverse .detail-visual{order:1}.detail-index,.visual-label,.about-index,.contact-panel-index{color:#566d72;font:8px ui-monospace,monospace;letter-spacing:.13em}.detail-copy h2{font:700 clamp(29px,3.6vw,42px)/1.12 var(--font-display);letter-spacing:-.045em;color:var(--navy);margin:16px 0}.detail-copy p{font-size:13px;color:#65777d;line-height:1.85;margin-bottom:20px}.detail-visual .visual-label{display:block;margin-bottom:8px}.detail-visual .flow-canvas{height:310px}.detail-visual .flow-node{width:120px}.detail-visual .node-b{width:133px}.detail-visual .flow-status{bottom:14px}.detail-visual .tag-a{left:23%}.note-band{background:var(--navy);padding:56px max(24px,calc((100% - var(--page))/2));display:grid;grid-template-columns:1fr .8fr;gap:70px;align-items:end}.note-band .eyebrow.light,.principle .eyebrow.light{color:#d7eee9}.note-band .eyebrow.light,.principle .eyebrow.light{color:#d7eee9}.note-band h2{font:700 35px/1.15 var(--font-display);color:#fff;letter-spacing:-.04em;max-width:480px;margin:17px 0 0}.note-band>p{font-size:13px;line-height:1.85;color:#b8c8ca;margin:0}
 .approach{max-width:var(--page);margin:auto;padding:74px 24px 90px;display:grid;grid-template-columns:1fr .82fr;gap:75px;align-items:start}.approach-step{display:grid;grid-template-columns:55px 1fr 30px;gap:13px;border-top:1px solid var(--line);padding:25px 0}.approach-number{color:var(--teal);font:11px ui-monospace,monospace}.approach-step h2{font:700 21px var(--font-display);color:var(--navy);margin:0 0 7px}.approach-step p{font-size:12px;color:#596e73;line-height:1.8;margin:0;max-width:430px}.approach-mark{justify-self:end;color:#8a9da0}.principle{background:var(--navy);padding:29px;color:#fff}.principle h2{font:700 30px/1.15 var(--font-display);letter-spacing:-.04em;margin:17px 0 10px}.principle>p{font-size:12px;line-height:1.8;color:#c0ced0;margin:0 0 24px}.deliverables{list-style:none;margin:0;padding:0;border-top:1px solid #ffffff35}.deliverables li{display:grid;grid-template-columns:32px 1fr;gap:11px;padding:14px 0;border-bottom:1px solid #ffffff35}.deliverables li>span{font:10px ui-monospace,monospace;color:#87d7c7;padding-top:2px}.deliverables b,.deliverables small{display:block}.deliverables b{font-size:12px;color:#fff}.deliverables small{font-size:10px;line-height:1.6;color:#c0ced0;margin-top:3px}
 .about-content{max-width:var(--page);margin:auto;padding:75px 24px 90px}.about-lead{display:grid;grid-template-columns:.45fr 1fr;gap:35px;align-items:start}.about-lead h2{font:700 clamp(34px,4.4vw,53px)/1.12 var(--font-display);letter-spacing:-.05em;color:var(--navy);max-width:620px;margin:0}.about-index{margin-top:12px}.about-story{margin:36px 0 70px 31%;max-width:660px}.about-story>p{font-size:16px;line-height:1.9;color:#5d7379}.principles{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:37px}.principles>div{border-top:1px solid var(--line);padding-top:13px}.principles span{color:var(--teal)}.principles h3{font:700 15px var(--font-display);color:var(--navy);margin:8px 0}.principles p{font-size:11px;line-height:1.7;color:#566c71;margin:0}.location-band{background:var(--paper);display:flex;align-items:center;gap:17px;padding:22px}.location-icon{display:grid;place-items:center;width:38px;height:38px;background:#fff;color:var(--teal);font-size:21px}.location-band p{margin:0;color:#526a71;font-size:12px}.location-coord{margin-left:auto;color:#536a70;font:8px ui-monospace,monospace}
 .contact-layout{max-width:var(--page);margin:auto;padding:73px 24px 90px;display:grid;grid-template-columns:1fr .82fr;gap:100px}.contact-brief h2{font:700 37px/1.15 var(--font-display);letter-spacing:-.04em;color:var(--navy);max-width:420px;margin:19px 0 14px}.contact-brief>p{color:#4d656d;font-size:13px;line-height:1.85;max-width:475px}.contact-brief ul{padding:0;list-style:none;margin:27px 0}.contact-brief li{padding:10px 0;border-bottom:1px solid var(--line);font-size:12px;color:#344f58}.contact-brief li::before{content:'↗';color:var(--teal);margin-right:12px}.contact-panel{position:relative;background:#e4f1ec;border:1px solid #c5dbd2;padding:32px;min-height:300px}.contact-panel-index{display:block}.contact-panel h2{font:700 24px/1.2 var(--font-display);color:var(--navy);letter-spacing:-.03em;margin:17px 0 8px}.contact-panel p{font-size:11px;color:#405b63;line-height:1.7}.contact-email,.contact-phone{display:flex;min-height:44px;width:fit-content;max-width:100%;align-items:center;gap:13px;padding:12px 15px;background:#087f76;color:white;text-decoration:none;font-size:13px;font-weight:700;margin:12px 0;overflow-wrap:anywhere}.contact-phone{background:#14384b}.contact-email span,.contact-phone span{flex:none}.contact-email:focus-visible,.contact-phone:focus-visible{outline-color:#10283f}.contact-location{position:absolute;bottom:18px;left:32px;right:32px;border-top:1px solid #bed5cb;padding-top:11px;font-size:10px;color:#405b61}
 .contact-layout{grid-template-columns:.72fr 1fr;gap:60px}.direct-contact{display:grid;gap:8px;margin-top:25px;font-size:12px}.direct-contact a{color:#075f59;text-underline-offset:3px;overflow-wrap:anywhere}
 .legal-content{max-width:var(--page);margin:auto;padding:60px 24px 100px}.legal-content dl{max-width:850px;margin:0}.legal-content dl>div{display:grid;grid-template-columns:220px 1fr;gap:20px;padding:16px 0;border-bottom:1px solid var(--line)}.legal-content dt{font-size:12px;color:#566c70}.legal-content dd{margin:0;font-size:13px;color:var(--navy)}.legal-content dd a{color:inherit}
 .page-bottom{background:var(--paper);padding:57px max(24px,calc((100% - var(--page))/2));display:flex;align-items:center;justify-content:space-between;gap:25px}.page-bottom h2{font:700 clamp(28px,3.5vw,41px)/1.14 var(--font-display);letter-spacing:-.04em;color:var(--navy);max-width:640px;margin:13px 0 0}.page-bottom .button-primary{white-space:nowrap}
 @media(max-width:800px){.detail-row,.detail-row.reverse{grid-template-columns:1fr;gap:25px;padding:48px 0}.detail-row.reverse .detail-copy,.detail-row.reverse .detail-visual{order:initial}.note-band{grid-template-columns:1fr;gap:20px;padding:45px 24px}.approach{grid-template-columns:1fr;gap:40px;padding-top:55px}.principle{max-width:600px}.contact-layout{grid-template-columns:1fr;gap:35px;padding-top:55px}.contact-panel{min-height:280px}.about-lead{grid-template-columns:1fr;gap:14px}.about-story{margin:30px 0 55px 12%}}
 @media(max-width:560px){.page-hero{padding:57px 20px 45px}.page-hero h1{font-size:clamp(34px,9.8vw,48px);line-height:1.12}.page-hero p{font-size:13px}.service-detail{padding:0 20px 30px}.detail-visual .flow-canvas{height:285px}.note-band{padding:40px 20px}.note-band .eyebrow.light,.principle .eyebrow.light{color:#d7eee9}.note-band .eyebrow.light,.principle .eyebrow.light{color:#d7eee9}.note-band h2{font-size:30px}.about-content{padding:53px 20px 65px}.about-story{margin-left:0}.principles{grid-template-columns:1fr;gap:15px}.location-band{align-items:flex-start;flex-wrap:wrap}.location-coord{width:100%;margin-left:55px}.contact-layout{padding:52px 20px 65px}.contact-brief h2{font-size:33px}.contact-panel{padding:25px}.contact-location{left:25px;right:25px}.legal-content{padding:44px 20px 65px}.legal-content dl>div{grid-template-columns:1fr;gap:4px}.page-bottom{padding:42px 20px;display:block}.page-bottom h2{margin-bottom:22px}.approach{padding:50px 20px 65px}.approach-step{grid-template-columns:34px 1fr 20px}.principle{padding:20px}.principle .flow-canvas{height:250px}}
</style>


